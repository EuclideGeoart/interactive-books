---
import { partForChapter } from '../../content/parts';
interface Props { current: string }
const { current } = Astro.props;
const part = partForChapter(current)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<nav class="book-navigation" aria-label="Chapters in this Part">
  <p class="nav-label">PART {part.numeral} / {part.title}</p>
  <ol class="part-chapters">
    {part.chapters.map(chapter => <li><a class:list={['chapter-link', { 'current-chapter': chapter.number === current }]} href={`${base}/chapters/${chapter.slug}/`} aria-current={chapter.number === current ? 'page' : undefined}><span>{chapter.number}</span>{chapter.title}{chapter.number === current && <span class="current-mark" aria-hidden="true">●</span>}</a></li>)}
  </ol>
  <a class="all-parts-link" href={`${base}/contents/`}>Explore all Parts &amp; chapters →</a>
</nav>
