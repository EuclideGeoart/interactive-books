---
import TraceLab from './TraceLab.astro';
import source from '../../../cpp/chapter-12/Traversal.hpp?raw';
const operations = [{'id': 'preorder', 'label': 'Preorder'}, {'id': 'inorder', 'label': 'Inorder'}, {'id': 'postorder', 'label': 'Postorder'}, {'id': 'bfs', 'label': 'Breadth-first'}];
---
<TraceLab id="traversal" chapter="traversal" source={source} fileName="Traversal.hpp" operations={operations} regions={['dfs', 'bfs']}>
  <label>Construction rule<select name="shape"><option value="complete">Complete shape (level order)</option><option value="bst">BST (insertion order)</option></select></label>
  <label>Starting tree<select name="preset"><option value="standard">A–B–C–D–E (65,66,67,68,69)</option><option value="empty">Empty tree</option><option value="single">Single root</option><option value="skewed">10,20,30,40,50,60 (chain under BST rule)</option><option value="custom">Custom integers</option></select></label>
  <label>Custom values (under selected rule)<input name="values" value="65,66,67,68,69" maxlength="90" placeholder="65,66,67,68,69" /></label>

</TraceLab>
<script>import '../../scripts/tree-labs';</script>
