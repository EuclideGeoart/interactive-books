---
import Diagram from './Diagram.astro';
import SourceCode from '../code/SourceCode.astro';
import source from '../../../cpp/chapter-01/SinglyLinkedList.hpp?raw';
import { operations, operationLabels } from '../../visualizers/linked-list/model';
---
<div class="operation-lab" data-lab>
  <div class="lab-heading"><div><span class="eyebrow">INTERACTIVE LAB / 01</span><h3>Make the pointers move.</h3></div><span class="live-indicator">Deterministic execution</span></div>
  <div class="operation-tabs" role="group" aria-label="List operation">
    {operations.map(operation => <button type="button" data-operation={operation} aria-pressed={operation === 'insert-head'}>{operationLabels[operation]}</button>)}
  </div>
  <form class="lab-inputs" data-operation-form>
    <label>Starting list<select name="preset"><option value="standard">10 → 20 → 30</option><option value="empty">Empty list</option><option value="single">Single node: 10</option><option value="duplicates">Duplicates: 10 → 10 → 20</option><option value="custom">Custom list…</option></select></label>
    <label data-custom-label hidden>Values, separated by commas<input name="custom" placeholder="10, 20, 30" type="text" maxlength="60" /></label>
    <label data-value-label>Value<input name="value" type="number" min="-999" max="999" step="1" value="5" required /></label>
    <label data-after-label hidden>After value<input name="after" type="number" min="-999" max="999" step="1" value="20" required /></label>
    <button type="submit" class="button button-primary">Load operation <span aria-hidden="true">↗</span></button>
  </form>
  <p data-input-error class="input-error" role="alert" hidden></p>
  <div class="lab-workspace">
    <Diagram id="lab" compact />
    <div class="code-pane">
      <div class="code-title"><span><i></i> SinglyLinkedList.hpp</span><span>C++20</span></div>
      <div class="operation-code" data-operation-code tabindex="0" role="region" aria-label="Synchronized C++ source">
        {operations.map(region => <SourceCode source={source} region={region} interactive />)}
      </div>
      <div class="code-status"><span class="active-dot"></span><span data-code-status>Click a line number to jump to its execution.</span></div>
    </div>
  </div>
  <div class="step-explanation" aria-live="polite" aria-atomic="true"><span class="step-badge" data-event>BEFORE</span><div><strong data-step-title>Ready to insert 5 at the head</strong><p data-step-explanation>Watch storage, links, and references change one step at a time.</p></div></div>
  <div class="playback-controls">
    <div class="mobile-step-context"><span data-mobile-event>BEFORE</span><code data-mobile-code>Choose Play or Next to begin.</code></div>
    <div class="playback-actions"><button type="button" data-action="reset" aria-label="Reset operation" title="Reset operation">↺</button><button type="button" data-action="previous" aria-label="Previous step" title="Previous step">←</button><button type="button" class="play-button" data-action="play">▶ <span>Play</span></button><button type="button" data-action="next" aria-label="Next step" title="Next step">→</button></div>
    <div class="step-progress"><span data-step-count>Step 0 / 7</span><input type="range" min="0" max="7" value="0" data-scrubber aria-label="Execution step" /></div>
    <label class="speed-label">Speed<select data-speed aria-label="Playback speed"><option value="0.5">0.5×</option><option value="1" selected>1×</option><option value="2">2×</option><option value="4">4×</option></select></label>
  </div>
  <div class="lab-bottom"><div class="segmented" role="group" aria-label="Operation phase"><button type="button" data-phase="before" aria-pressed="true">Before</button><button type="button" data-phase="steps" aria-pressed="false">Step-by-step</button><button type="button" data-phase="after" aria-pressed="false">After</button></div><div class="complexity-counters"><span>Visited <b data-visits>0</b></span><span>Value comparisons <b data-comparisons>0</b></span><span>Pointer writes <b data-writes>0</b></span></div></div>
  <details class="before-after"><summary>Compare before and after</summary><dl><div><dt>Before</dt><dd data-before></dd></div><div><dt>After</dt><dd data-after></dd></div></dl></details>
  <div class="lab-invariants"><div class="invariant-title"><span class="eyebrow">LIVE INVARIANTS</span><strong data-invariant-summary>✓ All invariants valid</strong></div><ul data-invariants></ul></div>
</div>
<script>import '../../scripts/lab';</script>
