---
import '../styles/diagram-fit.css';
import '../styles/foundations.css';
import SiteLayout from './SiteLayout.astro';
import BookNav from '../components/book/BookNav.astro';
import { partForChapter } from '../content/parts';
interface Props { number?: string; title?: string }
const { number = '01', title = 'Singly Linked List' } = Astro.props;
const part = partForChapter(number)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const outline = number === '00' ? [
  ['reading', 'Reading C++'], ['objects', 'Storage & lifetime'], ['pointers', 'Pointers & slots'], ['types', 'Classes & construction'], ['ownership', 'Ownership & moves'], ['contracts', 'Guards & exceptions'], ['containers', 'Containers & views'], ['generic', 'Operators & templates'], ['indexing', 'Iterators & indices'], ['later', 'Advanced previews'], ['reasoning', 'Cost & invariants'], ['implementation', 'Canonical C++'], ['exercises', 'Challenges'], ['summary', 'Chapter summary'],
] : [
  ['mental-model', 'Visual mental model'], ['intuition', 'Intuition'], ['memory', 'Structure & memory'], ['operations', 'Interactive operations'], ['implementation', 'C++ implementation'], ['pointer-trace', 'Pointer trace'], ['invariants', 'Invariants'], ['complexity', 'Complexity explorer'], ['break-it', 'Break-It mode'], ['analogy', 'Real-world analogy'], ['engineering', 'Engineering insight'], ['exercises', 'Challenges'], ['summary', 'Chapter summary'],
];
---
<SiteLayout title={title} number={number} description={`Learn ${title.toLowerCase()} through exact execution traces, live memory diagrams, and complete, tested C++20 code.`}>
  <div class="chapter-toolbar">
    <nav class="reader-breadcrumb" aria-label="Breadcrumb"><a href={`${base}/`}>Book I</a><span aria-hidden="true">/</span><a href={`${base}/contents/#${part.id}`}>Part {part.numeral} · {part.title}</a><span aria-hidden="true">/</span><span aria-current="page">Chapter {number}</span></nav>
    <button class="part-menu-button" type="button" data-nav-toggle aria-label="Chapters in this Part" aria-haspopup="dialog" aria-controls="part-navigation" aria-expanded="false">Chapters in this Part <span aria-hidden="true">☰</span></button>
  </div>
  <div class="chapter-reader">
    <aside class="reading-rail" aria-label="Chapter outline and progress">
      <details class="reader-outline" data-reader-outline><summary>On this page</summary><nav class="chapter-outline" aria-label="On this page">{outline.map(([id, title], i) => <a href={`#${id}`}><span>{String(i + 1).padStart(2, '0')}</span>{title}</a>)}</nav></details>
      <div class="reading-progress"><div><span>CHAPTER PROGRESS</span><strong data-progress-label>0%</strong></div><progress data-reading-progress value="0" max="100" aria-label="Chapter reading progress"></progress><button type="button" data-reset-progress>Reset progress</button></div>
    </aside>
    <main id="main-content" class="chapter-content" tabindex="-1"><slot /></main>
  </div>
  <dialog slot="navigation" id="part-navigation" class="mobile-navigation" data-mobile-nav aria-labelledby="part-navigation-title"><div class="dialog-heading"><h2 id="part-navigation-title">Part {part.numeral} · {part.title}</h2><button class="icon-button" type="button" data-nav-close aria-label="Close navigation" autofocus>×</button></div><BookNav current={number} /><nav class="mobile-outline" aria-label="Chapter sections">{outline.map(([id, title]) => <a href={`#${id}`}>{title}</a>)}</nav></dialog>
</SiteLayout>
