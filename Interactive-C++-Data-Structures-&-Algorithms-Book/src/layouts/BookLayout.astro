---
import '../styles/book.css';
import '../styles/diagram-fit.css';
import '../styles/foundations.css';
import BookNav from '../components/book/BookNav.astro';
import { searchIndex } from '../content/search';
import { chapters } from '../content/book';
interface Props { number?: string; title?: string }
const { number = '01', title = 'Singly Linked List' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const outline = number === '00' ? [
  ['reading', 'Reading C++'], ['objects', 'Storage & lifetime'], ['pointers', 'Pointers & slots'], ['types', 'Classes & construction'], ['ownership', 'Ownership & moves'], ['contracts', 'Guards & exceptions'], ['containers', 'Containers & views'], ['generic', 'Operators & templates'], ['indexing', 'Iterators & indices'], ['later', 'Advanced previews'], ['reasoning', 'Cost & invariants'], ['implementation', 'Canonical C++'], ['exercises', 'Challenges'], ['summary', 'Chapter summary'],
] : [
  ['mental-model', 'Visual mental model'], ['intuition', 'Intuition'], ['memory', 'Structure & memory'], ['operations', 'Interactive operations'], ['implementation', 'C++ implementation'], ['pointer-trace', 'Pointer trace'], ['invariants', 'Invariants'], ['complexity', 'Complexity explorer'], ['break-it', 'Break-It mode'], ['analogy', 'Real-world analogy'], ['engineering', 'Engineering insight'], ['exercises', 'Challenges'], ['summary', 'Chapter summary'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`Learn ${title.toLowerCase()} through exact execution traces, live memory diagrams, and complete, tested C++20 code.`} />
    <meta name="theme-color" content="#142b40" />
    <title>{title} — The Interactive C++ Book</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}/icons/icon-192.png`} />
    <script is:inline>try{const t=localStorage.getItem('cpp-book:theme');document.documentElement.dataset.theme=t||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{document.documentElement.dataset.theme='light'}</script>
  </head>
  <body data-chapter-number={number}>
    <a class="skip-link" href="#main-content">Skip to chapter content</a>
    <aside class="book-sidebar" aria-label="Book sidebar">
      <a class="book-brand" href={`${base}/`}><span class="brand-symbol" aria-hidden="true">[<b>→</b>]</span><span>C++<small>DATA STRUCTURES<br/>& ALGORITHMS</small></span></a>
      <div class="sidebar-scroll"><BookNav current={number} /><nav class="chapter-outline" aria-label="On this page"><p class="nav-label">IN THIS CHAPTER</p>{outline.map(([id, title], i) => <a href={`#${id}`}><span>{String(i + 1).padStart(2, '0')}</span>{title}</a>)}</nav></div>
      <div class="reading-progress"><div><span>CHAPTER PROGRESS</span><strong data-progress-label>0%</strong></div><progress data-reading-progress value="0" max="100" aria-label="Chapter reading progress"></progress><p>One concept at a time.</p><button type="button" data-reset-progress>Reset progress</button></div>
    </aside>
    <div class="book-body">
      <header class="topbar"><div class="breadcrumb"><button class="icon-button" type="button" data-nav-toggle aria-label="Toggle book navigation" aria-expanded="true"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><rect x="2" y="3" width="14" height="12" rx="2" fill="none" stroke="currentColor"/><path d="M7 3v12" stroke="currentColor"/></svg></button><a href={`${base}/`}>The interactive C++ book</a><span class="breadcrumb-slash">/</span><span class="breadcrumb-current">Chapter {number}</span></div><div class="topbar-actions"><button type="button" class="search-button" data-search-open aria-label="Search the book"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5"/></svg><span>Search the book</span><kbd>⌘ K</kbd></button><button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme"><span aria-hidden="true">◐</span></button></div></header>
      <main id="main-content" class="chapter-content"><slot /></main>
      <footer class="book-footer"><div class="book-footer-signature"><span>[→] THE INTERACTIVE C++ BOOK</span><small>Created by Mario Balit with Chatgpt</small></div><p>Understand the structure. See the execution.</p><a href="#top">Back to top ↑</a></footer>
    </div>
    <dialog class="mobile-navigation" data-mobile-nav aria-label="Book navigation"><div class="dialog-heading"><strong>Explore the book</strong><button class="icon-button" type="button" data-nav-close aria-label="Close navigation">×</button></div><BookNav current={number} /><nav class="mobile-outline" aria-label="Chapter sections">{outline.map(([id, title]) => <a href={`#${id}`}>{title}</a>)}</nav></dialog>
    <dialog class="search-dialog" data-search-dialog aria-labelledby="search-title"><div class="dialog-heading"><h2 id="search-title">Search the book</h2><button class="icon-button" type="button" data-search-close aria-label="Close search">×</button></div><label class="sr-only" for="book-search">Search Chapters 0–{Number(chapters.at(-1)!.number)}</label><input id="book-search" type="search" placeholder="Try “pointer”, “delete”, or “complexity”…" autocomplete="off" /><p class="search-scope">Search all {chapters.length} available chapters</p><ul data-search-results></ul><p data-search-count class="sr-only" aria-live="polite"></p></dialog>
    <script type="application/json" data-search-index set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')} />
    <script>import '../scripts/book'; import '../scripts/register-sw';</script>
  </body>
</html>
