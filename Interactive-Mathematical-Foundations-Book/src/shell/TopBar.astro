---
import { href } from './href';
import Mark from './Mark.astro';
import PartRuler from './PartRuler.astro';
interface Props { part?: number }
const { part } = Astro.props;
---
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href={href('/')}><Mark /><span class="brand-text">Mathematical <em>Foundations</em></span></a>
    <PartRuler current={part} />
    <div class="topbar-actions">
      <button type="button" class="topbar-button" data-map-open aria-haspopup="dialog" aria-label="Contents">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M3 5h14M3 10h14M3 15h9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span class="label" aria-hidden="true">Contents</span>
      </button>
      <button type="button" class="topbar-button icon-only" data-theme-toggle aria-label="Dark theme" aria-pressed="false">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="6.2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 3.8a6.2 6.2 0 0 1 0 12.4z" fill="currentColor"/></svg>
      </button>
    </div>
  </div>
</header>
