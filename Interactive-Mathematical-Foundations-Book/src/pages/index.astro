---
import BaseLayout from '../shell/BaseLayout.astro';
import PartEmblem from '../shell/PartEmblem.astro';
import VectorStage from '../lessons/foundation/VectorStage';
import { parts } from '../curriculum/curriculum';
import { availableCount, chapterCount, findChapter, firstAvailable, partAnchor, partStats } from '../curriculum/queries';
import { href } from '../shell/href';
import { renderTex } from '../platform/tex';

const method = [
  ['See it', 'Meet the idea as a picture you can touch before any symbol appears.'],
  ['Manipulate it', 'Change one quantity and watch every consequence follow, in the same frame.'],
  ['Understand the mechanism', 'Follow the same numbers through the inspector and the formula.'],
  ['Derive the mathematics', 'Now the notation arrives, with something already in your hands to attach it to.'],
  ['Implement it', 'Run it in Python and NumPy, checked against the browser model.'],
] as const;

const completeParts = parts.filter(part => partStats(part).available === part.chapters.length);

const equations = [
  { tex: String.raw`\theta_{k+1}=\theta_k-\eta\,\nabla_\theta L(\theta_k)`, gloss: 'One step of learning: move the parameters a little against the gradient.', where: 'Part VI · Optimization' },
  { tex: String.raw`p_i=\frac{e^{z_i}}{\sum_j e^{z_j}}`, gloss: 'Softmax turns unconstrained scores into a probability distribution.', where: 'Part VII · Information Theory' },
  { tex: String.raw`-\sum_i y_i\log p_i`, gloss: 'Cross entropy: how surprised a model is by the right answer.', where: 'Part VII · Information Theory' },
  { tex: String.raw`\mathbf{y}=A\mathbf{x}+\mathbf{b}`, gloss: 'A linear layer: a transformation of space, then a shift.', where: 'Part II · Linear Algebra' },
];
---
<BaseLayout title="Interactive Mathematical Foundations — Book II" description="A visual-first book on the mathematics behind computing and machine learning: drag a vector, watch the numbers answer, then follow the derivation.">
  <div class="landing">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="kicker"><strong>Interactive Mathematical Foundations</strong> for Computing &amp; Machine Learning · Book II</p>
        <h1 id="hero-title">See the mathematics <em>move</em>.</h1>
        <p class="lede">A book where every formula has a handle. Pull on a vector, watch the numbers answer, then follow the derivation — from vectors and calculus to gradient descent and softmax.</p>
        <p class="actions">
          <a class="button primary" href={href('/contents/')}>Explore the map</a>
          {firstAvailable?.chapter.slug && <a class="button" href={href(`/chapters/${firstAvailable.chapter.slug}/`)}>Start with {firstAvailable.id}</a>}
          <a class="button" href={href('/foundation/')}>Open the foundation demo</a>
        </p>
      </div>
      <figure class="hero-demo">
        <VectorStage client:load variant="hero" />
        <figcaption>A live platform demo. The tip of the arrow is draggable, and every number beside it is computed from that one point. Chapter I.3, <a href={href(`/chapters/${findChapter('I.3')?.chapter.slug}/`)}><em>Vectors</em></a>, builds on this.</figcaption>
      </figure>
    </section>

    <section class="method" aria-labelledby="method-title">
      <div class="section-head"><h2 id="method-title">One way of learning, in five moves</h2><p>Every chapter follows the same order, so the mathematics always arrives with a mental picture already attached.</p></div>
      <ol>{method.map(([title, text]) => <li><h3>{title}</h3><p>{text}</p></li>)}</ol>
    </section>

    <section class="promise" aria-label="The identity rule">
      <blockquote>If a formula says <span class="nowrap"><span set:html={renderTex(String.raw`\mathbf{v}=(3,2)`, false)} />,</span> the arrow ends at <span class="nowrap"><span set:html={renderTex('(3,2)', false)} />.</span></blockquote>
      <p>The picture, the inspector and the formula are three views of <strong>one</strong> mathematical state. Nothing on the page is a decorative approximation; if a rounded number appears, it is marked as one.</p>
    </section>

    <section aria-labelledby="parts-title">
      <div class="section-head"><h2 id="parts-title">Eight Parts, in the order they depend on each other</h2><p>Each emblem is drawn from real mathematics of its Part, not from a stock icon set.</p></div>
      <ul class="part-grid">
        {parts.map(part => {
          const stats = partStats(part);
          return (
            <li>
              <a class="part-card" href={`${href('/contents/')}#${partAnchor(part)}`}>
                <PartEmblem index={part.index} />
                <span class="body">
                  <span class="numeral">Part {part.numeral}</span>
                  <h3>{part.title}</h3>
                  <span class="tagline">{part.tagline}</span>
                  <span class="count">{stats.total} chapters · {stats.available === 0 ? 'planned' : `${stats.available} written`}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <section aria-labelledby="eq-title">
      <div class="section-head"><h2 id="eq-title">Equations this book makes mechanical</h2><p>By the end, each of these should read as a description of something you have already moved with your hands.</p></div>
      <div class="equations">
        {equations.map(eq => (
          <article class="equation-card">
            <div set:html={renderTex(eq.tex, true)} />
            <p>{eq.gloss}</p>
            <p class="where">{eq.where}</p>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="status-title">
      <div class="section-head"><h2 id="status-title">Where things stand</h2><p>{availableCount} of {chapterCount} chapters are written{completeParts.length ? <>; {completeParts.map(part => `Part ${part.numeral} (${part.title})`).join(' and ')} {completeParts.length === 1 ? 'is' : 'are'} complete</> : ''}. The platform exists, the curriculum is fixed, and I.3 Vectors is the reference chapter every other chapter is measured against.</p></div>
      <div class="status-grid">
        <div class="status-col"><h3>In place</h3><ul><li>Book shell, navigation and the map</li><li>Mathematical typography, inline and display</li><li>Coordinate plane, draggable point, inspector, parameter controls</li><li>Python oracle checked against the browser model</li>{completeParts.map(part => <li>Part {part.numeral}, {part.title}: all {part.chapters.length} chapters</li>)}</ul></div>
        <div class="status-col next"><h3>Next</h3><ul><li>Independent review of Part I</li><li>Then Part II, Linear Algebra, built on it</li></ul></div>
        <div class="status-col later"><h3>Later</h3><ul><li>Linear Algebra and Calculus</li><li>Probability, Statistics, Optimization</li><li>Information Theory and Numerical Computing</li></ul></div>
      </div>
    </section>
  </div>
</BaseLayout>
