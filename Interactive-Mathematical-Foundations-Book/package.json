{
  "name": "interactive-mathematical-foundations",
  "version": "0.1.0",
  "description": "Book II — Interactive Mathematical Foundations for Computing & Machine Learning (M0+M2 foundation)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/production-state.mjs dist",
    "build:subpath": "node scripts/build-subpath.mjs",
    "serve": "node scripts/serve-dist.mjs dist / 4451",
    "serve:subpath": "node scripts/serve-dist.mjs dist-subpath /math-foundations 4452",
    "check": "astro check",
    "test": "vitest run",
    "test:oracle": "node scripts/run-oracle.mjs",
    "check:dist": "node scripts/check-dist.mjs dist / && node scripts/check-dist.mjs dist-subpath /math-foundations/",
    "test:e2e": "playwright test --trace off",
    "test:e2e:subpath": "playwright test --config playwright.subpath.config.ts --trace off",
    "measure:drag": "node scripts/measure-drag-latency.mjs",
    "oracle:setup": "node scripts/setup-oracle.mjs",
    "measure:validation": "node scripts/profile-validation.mjs",
    "validation:enumerate": "node scripts/enumerate-validation.mjs",
    "validation:isolation": "node scripts/probe-readonly-isolation.mjs",
    "validate:focused": "node scripts/validate.mjs focused",
    "validate:production": "node scripts/validate.mjs focused --only production",
    "validate:milestone": "node scripts/validate.mjs milestone",
    "validate:exhaustive": "node scripts/validate.mjs exhaustive",
    "validate": "node scripts/validate.mjs exhaustive"
  },
  "dependencies": {
    "@astrojs/mdx": "4.3.14",
    "@astrojs/preact": "4.1.3",
    "@fontsource-variable/instrument-sans": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/source-serif-4": "^5.2.0",
    "astro": "5.18.2",
    "katex": "^0.16.0",
    "preact": "^10.27.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/katex": "^0.16.0",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
