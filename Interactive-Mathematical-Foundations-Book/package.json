{
  "name": "interactive-mathematical-foundations",
  "version": "0.1.0",
  "description": "Book II — Interactive Mathematical Foundations for Computing & Machine Learning (M0+M2 foundation)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:subpath": "BOOK_BASE=/math-foundations/ astro build --outDir dist-subpath",
    "serve": "node scripts/serve-dist.mjs dist / 4451",
    "serve:subpath": "node scripts/serve-dist.mjs dist-subpath /math-foundations 4452",
    "check": "astro check",
    "test": "vitest run",
    "test:oracle": "node scripts/run-oracle.mjs",
    "check:dist": "node scripts/check-dist.mjs dist / && node scripts/check-dist.mjs dist-subpath /math-foundations/",
    "test:e2e": "playwright test",
    "test:e2e:subpath": "playwright test --config playwright.subpath.config.ts",
    "oracle:setup": "sh scripts/setup-oracle.sh",
    "validate": "npm run check && npm test && npm run test:oracle && npm run build && npm run build:subpath && npm run check:dist && npm run test:e2e && npm run test:e2e:subpath"
  },
  "dependencies": {
    "@astrojs/mdx": "4.3.14",
    "@astrojs/preact": "4.1.3",
    "@fontsource-variable/instrument-sans": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/source-serif-4": "^5.2.0",
    "astro": "5.18.2",
    "katex": "^0.16.0",
    "preact": "^10.27.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/katex": "^0.16.0",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
