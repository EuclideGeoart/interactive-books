---
import { getEntry, render } from 'astro:content';
import ChapterLayout from '../shell/ChapterLayout.astro';
import Callout from '../shell/Callout.astro';
import Table from '../shell/Table.astro';

const entry = await getEntry('chapters', 'foundation-demo');
if (!entry) throw new Error('src/content/chapters/foundation-demo.mdx is missing');
const { Content, headings } = await render(entry);
---
<ChapterLayout data={entry.data} headings={headings}>
  <Content components={{ table: Table, Callout }} />
</ChapterLayout>
